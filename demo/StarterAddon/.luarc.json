{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "workspace.library": ["../../library"],
  "runtime.builtin": {
    "bit": "disable",
    "bit32": "disable",
    "debug": "disable",
    "ffi": "disable",
    "io": "disable",
    "jit": "disable",
    "os": "disable",
    "package": "disable",
    "utf8": "disable"
  },
  "diagnostics.disable": ["lowercase-global"]
}
